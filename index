<!DOCTYPE html>
<html>
<head>
<meta charset="UTF-8">
<title>點擊相片播放音樂</title>
</head>
<body>

<h2>點擊下面相片播放音樂</h2>

<audio id="myAudio">
  <source src="music.mp3" type="audio/mpeg">
  瀏覽器唔支援音樂播放


<img id="myPic" src="photo.jpg" alt="打卡相片" width="450" style="cursor:pointer;">

<script>
const audio = document.getElementById("myAudio");
const pic = document.getElementById("myPic");

pic.onclick = function() {
  if(audio.paused){
    audio.play();
  }else{
    audio.pause();
  }
}
</script>

</body>
</html>
